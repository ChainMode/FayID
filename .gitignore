# 默认忽略一切，仅放行公开协议产物、参考实现、测试套件、README.md、LICENSE 与 .gitignore 自身
/*
!/docs/
!/schema/
!/schemas/
!/src/
!/bin/
!/vectors/
!/tests/
!/package.json
!/README.md
!/LICENSE
!/LICENSE-DOCS
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/docs-ci.yml
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.yml
!/.github/ISSUE_TEMPLATE/feature_request.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/pull_request_template.md

# 构建与系统噪声
.DS_Store
node_modules/
